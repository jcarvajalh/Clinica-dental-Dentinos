---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';
import { site } from '@/data/site';
import CtaButtons from '@/components/ui/CtaButtons.astro';

/*
 * Sección reutilizable "Visítanos / Ubicación" (§3: vive en components/sections/
 * porque aparece en varias páginas — home, contacto…).
 * Composición: mapa central con tarjeta-pin de la clínica + 4 fotos flotantes
 * decorativas (rotadas) a los lados + CTA. Las fotos flotantes son decorativas:
 * se ocultan en móvil para evitar ruido.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  id?: string;
}

const {
  eyebrow = 'Visítanos',
  title = 'Estamos ubicados en Teatinos, Málaga',
  id = 'location',
} = Astro.props;
const titleId = `${id}-title`;

const mapsHref = site.mapsUrl || '#';
---

<section class="location" aria-labelledby={titleId}>
  <header class="location__head">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={titleId} class="section-title">{title}</h2>
  </header>

  <div class="location__stage">
    <div class="location__map">
      <Image
        src={img('location-mapa')}
        alt="Mapa de la ubicación de la Clínica Dental Dentinos en Teatinos, Málaga"
        widths={[560, 876, 1200, 1600]}
        sizes="(min-width: 56.25rem) 56vw, 92vw"
        class="location__map-img"
      />

      <figure class="place">
        <span class="place__marker" aria-hidden="true">
          <span class="place__pin">
            <Image src={img('location-pin')} alt="" width={17} height={16} />
          </span>
        </span>

        <Image
          src={img('location-fachada')}
          alt="Fachada de la Clínica Dental Dentinos"
          widths={[108, 216, 320]}
          sizes="10rem"
          class="place__photo"
        />

        <figcaption class="place__info">
          <p class="place__name">Clínica Dental Dentinos</p>
          <p class="place__hours">L - V 10:00 am - 9:00 pm</p>
          <p class="place__amenities">Wifi | Café | Comfort</p>
          <a
            href={mapsHref}
            class="place__maps"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver en maps
          </a>
        </figcaption>
      </figure>
    </div>

    {/* Las 4 fotos del interior, en una fila horizontal bajo el mapa (decorativas) */}
    <div class="location__gallery" aria-hidden="true">
      <Image src={img('location-equipo')} alt="" widths={[224, 340, 460]} sizes="(min-width: 56.25rem) 14vw, 23vw" class="location__photo" />
      <Image src={img('location-sala')} alt="" widths={[224, 340, 460]} sizes="(min-width: 56.25rem) 14vw, 23vw" class="location__photo" />
      <Image src={img('location-recepcion')} alt="" widths={[224, 340, 460]} sizes="(min-width: 56.25rem) 14vw, 23vw" class="location__photo" />
      <Image src={img('location-consulta')} alt="" widths={[224, 340, 460]} sizes="(min-width: 56.25rem) 14vw, 23vw" class="location__photo location__photo--raise" />
    </div>
  </div>

  <div class="location__cta">
    <CtaButtons size="lg" />
  </div>
</section>

<style>
  .location {
    background-color: var(--color-white);
    padding-block: var(--section-py);
    overflow: hidden; /* las fotos flotantes rotadas no provocan scroll */
  }

  /* --- Cabecera -------------------------------------------------------- */
  .location__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-head);
    padding-inline: var(--inset-section);
    margin-bottom: clamp(1.5rem, 0.9rem + 2.4vw, 2.5rem);
  }

  /* --- Escenario: mapa centrado + fila de fotos debajo ----------------- */
  .location__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 1.8vw, 2rem);
    width: 100%;
    padding-inline: var(--gutter);
  }

  .location__map {
    position: relative;
    width: 100%;
    /* 10% más pequeño que antes: ~788px @1440 (≈56vw); sigue creciendo (§6). */
    max-width: clamp(18rem, 55.8vw, 65.7rem);
  }

  .location__map-img {
    width: 100%;
    height: auto;
    aspect-ratio: 876 / 407;
    object-fit: cover;
    border-radius: var(--radius-media); /* 50px @1440 */
  }

  /* --- Fila de 4 fotos del interior bajo el mapa ----------------------- */
  /* Las 4 ocupan juntas el mismo ancho que el mapa: celdas iguales (1/4 cada
     una) con object-fit cover, así todas lucen el mismo tamaño cuadrado
     independientemente del recorte/proporción de cada archivo. */
  .location__gallery {
    display: flex;
    gap: clamp(0.625rem, 0.3rem + 1.1vw, 1.25rem);
    width: 100%;
    max-width: clamp(18rem, 55.8vw, 65.7rem); /* mismo ancho que el mapa */
  }

  .location__photo {
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3; /* más anchas que altas */
    object-fit: cover;
    object-position: center top; /* encuadra hacia arriba: no corta los rostros */
    border-radius: clamp(0.875rem, 0.5rem + 1.2vw, 1.5rem);
  }

  /* La cuarta foto se sube un poco (encuadre algo más abajo del borde). */
  .location__photo--raise {
    object-position: center 18%;
  }

  /* --- Tarjeta-pin sobre el mapa --------------------------------------- */
  .place {
    position: absolute;
    left: 36%;
    top: 16%;
    z-index: 3;
    width: clamp(8.5rem, 7rem + 4vw, 10rem); /* legible aunque el mapa escale */
    display: flex;
    flex-direction: column;
    gap: clamp(0.25rem, 0.2rem + 0.2vw, 0.4375rem);
    padding: clamp(0.4375rem, 0.35rem + 0.3vw, 0.625rem);
    background-color: var(--color-white);
    border-radius: 1.25rem; /* 20px */
    box-shadow: var(--shadow-glass);
  }

  /* Pin: círculo azul con icono + cola triangular hacia la tarjeta. */
  .place__marker {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .place__pin {
    display: grid;
    place-items: center;
    width: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    height: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    border-radius: 50%;
    background-color: var(--color-blue-darker);
  }

  .place__pin :global(img) {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }

  /* Cola triangular blanca que apunta a la tarjeta. */
  .place__marker::after {
    content: '';
    width: 0;
    height: 0;
    border-inline: 0.4375rem solid transparent;
    border-top: 0.375rem solid var(--color-white);
    margin-top: -0.0625rem;
  }

  .place__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 108 / 82;
    object-fit: cover;
    border-radius: 0.875rem; /* 14px */
  }

  .place__info {
    display: flex;
    flex-direction: column;
    gap: clamp(0.1875rem, 0.15rem + 0.15vw, 0.3125rem);
  }

  .place__name {
    font-weight: 500;
    font-size: clamp(0.625rem, 0.58rem + 0.2vw, 0.75rem); /* 10 → 12px */
    line-height: 1.2;
    color: var(--color-black);
  }

  .place__hours,
  .place__amenities {
    font-size: clamp(0.625rem, 0.6rem + 0.12vw, 0.6875rem); /* 10 → 11px */
    line-height: 1.2;
    color: var(--color-black);
  }

  .place__maps {
    align-self: flex-start;
    margin-top: 0.125rem;
    padding: 0.1875rem 0.75rem;
    font-size: clamp(0.5625rem, 0.53rem + 0.15vw, 0.6875rem); /* 9 → 11px */
    line-height: 1.2;
    color: var(--color-blue-light);
    background-color: var(--color-blue-dark-active);
    border-radius: var(--radius-btn-sm); /* 15px */
    transition: background-color var(--duration-base) var(--ease-out-soft);
  }

  .place__maps:hover {
    background-color: var(--color-blue-darker);
  }

  /* --- CTA inferior (centrado) ---------------------------------------- */
  .location__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 1rem + 3vw, 2.75rem);
  }

  /* --- Móvil: tarjeta-pin algo mayor ---------------------------------- */
  @media (max-width: 56.1875rem) {
    .place {
      width: clamp(9rem, 40vw, 11rem);
    }
  }
</style>
