---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';
import { tratamientos, defaultTreatmentSlug } from '@/data/tratamientos';
import CtaButtons from '@/components/ui/CtaButtons.astro';
---

<section class="services" aria-labelledby="services-title">
  <div class="services__inner">
    <header class="services__head">
      <p class="eyebrow">Tratamientos</p>
      <h2 id="services-title" class="section-title">
        Descubre nuestros tratamientos en Teatinos, Málaga
      </h2>
    </header>

    <div class="services__grid">
      <!-- Lista seleccionable (tabs verticales): muestra ~4 y desliza el resto -->
      <div class="services__list-wrap">
        <div
          class="services__list"
          role="tablist"
          aria-orientation="vertical"
          aria-label="Tratamientos"
        >
          {
            tratamientos.map((t) => {
              const active = t.slug === defaultTreatmentSlug;
              return (
                <button
                  type="button"
                  role="tab"
                  id={`svc-tab-${t.slug}`}
                  class="services__tab"
                  aria-controls={`svc-panel-${t.slug}`}
                  aria-selected={active ? 'true' : 'false'}
                  tabindex={active ? 0 : -1}
                  data-svc={t.slug}
                >
                  <span class="services__row">
                    <span class="services__name">{t.name}</span>
                    {t.price && <span class="services__price">{t.price}</span>}
                  </span>
                  <span class="services__summary">{t.summary}</span>
                </button>
              );
            })
          }
        </div>

        <div class="services__nav" aria-hidden="true">
          <button
            type="button"
            class="services__arrow"
            data-dir="prev"
            aria-label="Ver tratamientos anteriores"
            tabindex="-1"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="18 15 12 9 6 15" />
            </svg>
          </button>
          <button
            type="button"
            class="services__arrow"
            data-dir="next"
            aria-label="Ver más tratamientos"
            tabindex="-1"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>
      </div>

      <div class="services__content">
        <!-- Imagen (cambia según el tratamiento activo) -->
        <div class="services__media">
          {
            tratamientos.map((t) => {
              const active = t.slug === defaultTreatmentSlug;
              return t.image ? (
                <Image
                  src={img(t.image)}
                  alt={`Tratamiento de ${t.name.toLowerCase()} en la Clínica Dental Dentinos`}
                  widths={[300, 417, 600, 834]}
                  sizes="(min-width: 1024px) 30vw, 90vw"
                  class="services__photo"
                  data-svc-media={t.slug}
                  hidden={!active}
                />
              ) : (
                <div
                  class="services__photo services__photo--placeholder"
                  data-svc-media={t.slug}
                  hidden={!active}
                >
                  [IMAGEN PENDIENTE]
                </div>
              );
            })
          }
        </div>

        <!-- Panel de información (cambia según el tratamiento activo) -->
        <div class="services__panels">
          {
            tratamientos.map((t) => {
              const active = t.slug === defaultTreatmentSlug;
              return (
                <div
                  class="services__panel"
                  id={`svc-panel-${t.slug}`}
                  role="tabpanel"
                  aria-labelledby={`svc-tab-${t.slug}`}
                  data-svc-panel={t.slug}
                  tabindex="0"
                  hidden={!active}
                >
                  <p class="services__desc">
                    {t.description ? (
                      <>
                        {t.description}{' '}
                        {t.descriptionAccent && (
                          <em class="accent">{t.descriptionAccent}</em>
                        )}
                      </>
                    ) : (
                      <span class="services__pending">
                        [TEXTO PENDIENTE — descripción de {t.name}]
                      </span>
                    )}
                  </p>

                  <div class="services__specialists">
                    <ul class="services__avatars" aria-hidden="true">
                      <li class="services__avatar" />
                      <li class="services__avatar" />
                      <li class="services__avatar" />
                    </ul>
                    <span class="services__specialists-label">
                      Nuestros especialistas
                    </span>
                  </div>

                  <a href={t.href} class="btn btn-primary btn-sm services__more">
                    Conoce las opciones
                  </a>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <div class="services__cta">
      <CtaButtons size="lg" />
    </div>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-white);
    padding-block: var(--section-py);
  }

  .services__inner {
    padding-inline: var(--inset-section);
  }

  .services__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-head);
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .services__grid {
    display: grid;
    gap: clamp(2rem, 1.2rem + 3vw, 3rem);
  }

  /* --- Lista de tratamientos (tabs) ------------------------------------ */
  /* Muestra ~4 tratamientos; el resto se desliza con las flechas o la rueda,
     sin alterar la altura de la sección (viewport acotado por max-height). */
  .services__list-wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
  }

  .services__list {
    display: flex;
    flex-direction: column;
    max-height: clamp(19rem, 13rem + 16vw, 28.375rem); /* ~4 tratamientos */
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-snap-type: y proximity;
    /* Barra nativa oculta: el deslizamiento se hace con las flechas/rueda. */
    scrollbar-width: none;
  }
  .services__list::-webkit-scrollbar {
    display: none;
  }

  .services__tab {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    text-align: left;
    padding-block: clamp(1.25rem, 0.9rem + 1.4vw, 1.625rem);
    letter-spacing: -0.04em;
    scroll-snap-align: start;
    transition: opacity var(--duration-base) var(--ease-out-soft);
  }

  /* Líneas divisorias entre elementos (no antes del primero). */
  .services__tab + .services__tab {
    border-top: 0.8px solid var(--color-divider);
  }

  /* Sin espacio sobrante al inicio: la lista cuadra con la imagen. */
  .services__tab:first-child {
    padding-top: 0;
  }

  /* Título + precio en una fila; precio pegado al borde derecho. */
  .services__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .services__name {
    font-size: var(--text-h3); /* reducido para dejar sitio al precio */
    line-height: 1.05;
    color: var(--color-blue-dark-active);
    transition: opacity var(--duration-base) var(--ease-out-soft);
  }

  .services__price {
    flex-shrink: 0;
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.05;
    white-space: nowrap;
    color: var(--color-blue-darker);
  }

  .services__tab[aria-selected='false'] .services__price {
    opacity: 0.51;
  }

  /* --- Flechas de desplazamiento --------------------------------------- */
  .services__nav {
    display: flex;
    gap: 0.5rem;
  }

  .services__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--color-blue-darker);
    background-color: var(--color-blue-light-hover);
    transition:
      background-color var(--duration-base) var(--ease-out-soft),
      opacity var(--duration-base) var(--ease-out-soft);
  }

  .services__arrow:hover {
    background-color: var(--color-blue-light-active);
  }

  .services__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .services__summary {
    font-size: var(--text-body);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-blue-dark-hover);
  }

  /* Estado inactivo: título atenuado; activo: título pleno y resumen +peso. */
  .services__tab[aria-selected='false'] .services__name {
    opacity: 0.51;
  }
  .services__tab[aria-selected='true'] .services__summary {
    font-weight: 400;
  }

  .services__tab:hover .services__name {
    opacity: 1;
  }

  /* --- Contenido (imagen + panel) ------------------------------------- */
  .services__content {
    display: grid;
    gap: 0.625rem; /* 10px */
  }

  .services__media {
    position: relative;
    aspect-ratio: 417 / 454;
  }

  .services__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  .services__photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body);
    color: var(--color-blue-normal-active);
    background-color: var(--color-blue-light-active);
  }
  .services__photo--placeholder[hidden] {
    display: none;
  }

  /* Transición suave y breve al cambiar de tratamiento (imagen + panel).
     Usa --duration-base → se neutraliza con prefers-reduced-motion (global). */
  @keyframes svc-fade {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Se activa desde JS (clase .is-switching) para garantizar que la animación
     se reinicie en cada cambio de tratamiento, no solo al mostrarse. */
  .services__photo.is-switching,
  .services__panel.is-switching {
    animation: svc-fade var(--duration-base) var(--ease-out-soft);
  }

  /* --- Panel ---------------------------------------------------------- */
  .services__panel {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.1rem + 1.7vw, 1.875rem);
    background-color: var(--color-blue-light-hover);
    border-radius: var(--radius-media);
  }
  .services__panel[hidden] {
    display: none;
  }

  .services__desc {
    font-size: var(--text-lead); /* 18px @1440 */
    line-height: 1.6;
    letter-spacing: -0.04em;
    color: var(--color-blue-dark-hover);
  }

  /* «Sonrisa.» va más grande que el cuerpo del panel. */
  .services__desc .accent {
    font-size: var(--text-h3); /* 24px @1440 */
  }

  .services__pending {
    opacity: 0.6;
  }

  .services__specialists {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .services__avatars {
    display: flex;
    list-style: none;
    padding: 0;
  }

  .services__avatar {
    width: clamp(3rem, 2.4rem + 1.3vw, 4rem); /* 48 → 64px */
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--color-blue-normal);
    border: 4px solid var(--color-blue-light-hover); /* anillo = fondo del panel */
  }
  .services__avatar + .services__avatar {
    margin-left: -0.75rem; /* solapado */
  }

  .services__specialists-label {
    font-size: 0.875rem; /* 14px */
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--color-black);
  }

  /* Botón "Leer más": mismo tamaño que los CTA del hero (btn-sm).
     margin-top:auto lo empuja al fondo del panel; align-self lo alinea dcha. */
  .services__more {
    align-self: flex-end;
    margin-top: auto;
  }

  /* CTA centrado al pie de la sección (como en «Equipo médico»). */
  .services__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 1.8rem + 3vw, 3.75rem);
  }

  /* --- Escritorio (lg ≥ 1024px): lista | (imagen + panel) ------------- */
  @media (min-width: 1024px) {
    .services__grid {
      /* Lista 412px (ancho de las líneas) | par imagen+panel 844px. */
      grid-template-columns: minmax(0, 412fr) minmax(0, 844fr);
      align-items: start;
      column-gap: clamp(1.25rem, -0.0625rem + 1.46vw, 1.6875rem); /* → 20px */
    }

    .services__content {
      grid-template-columns: 1fr 1fr; /* imagen | panel, iguales */
      align-items: stretch; /* el panel iguala la altura de la imagen */
    }

    /* El card iguala la caja de la imagen (misma proporción). */
    .services__panel {
      aspect-ratio: 417 / 454;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.services');
  if (root) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[data-svc-panel]'),
    );
    const medias = Array.from(
      root.querySelectorAll<HTMLElement>('[data-svc-media]'),
    );

    // Reinicia la animación de entrada (quita la clase, fuerza reflow, la repone).
    const playFade = (el: HTMLElement | undefined) => {
      if (!el) return;
      el.classList.remove('is-switching');
      void el.offsetWidth; // fuerza reflow → la animación arranca de cero
      el.classList.add('is-switching');
    };

    const activate = (slug: string, focus = false) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.svc === slug;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.svcPanel !== slug));
      medias.forEach((m) => (m.hidden = m.dataset.svcMedia !== slug));

      playFade(panels.find((p) => p.dataset.svcPanel === slug));
      playFade(medias.find((m) => m.dataset.svcMedia === slug));
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab.dataset.svc!));
      tab.addEventListener('keydown', (e) => {
        let next: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight')
          next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft')
          next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          activate(tabs[next].dataset.svc!, true);
        }
      });
    });

    /* --- Deslizar la lista (muestra ~4, desliza el resto) --------------- */
    const list = root.querySelector<HTMLElement>('.services__list');
    const arrows = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.services__arrow'),
    );

    if (list && arrows.length) {
      const syncArrows = () => {
        const max = list.scrollHeight - list.clientHeight;
        arrows.forEach((btn) => {
          const atStart = list.scrollTop <= 1;
          const atEnd = list.scrollTop >= max - 1;
          btn.disabled = btn.dataset.dir === 'prev' ? atStart : atEnd;
        });
      };

      arrows.forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = btn.dataset.dir === 'next' ? 1 : -1;
          const first = tabs[0];
          const step = first ? first.offsetHeight * 2 : list.clientHeight * 0.8;
          list.scrollBy({ top: dir * step, behavior: 'smooth' });
        });
      });

      list.addEventListener('scroll', syncArrows, { passive: true });
      syncArrows();
    }
  }
</script>
