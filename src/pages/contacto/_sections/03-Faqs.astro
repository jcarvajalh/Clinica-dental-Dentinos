---
import Faqs from '@/components/sections/Faqs.astro';
import CtaButtons from '@/components/ui/CtaButtons.astro';

/* Instancia de FAQ para la página de contacto. Respuestas reales a partir de los
 * datos del negocio (§1); la última queda [PENDIENTE] hasta confirmarla. */
const faqs = [
  {
    question: '¿Cómo puedo pedir cita en Dentinos?',
    answer:
      'Puedes solicitar tu cita por WhatsApp, por teléfono (+34 649 989 506 o 951 93 53 78), por correo electrónico o rellenando el formulario de esta página. Te confirmaremos la fecha lo antes posible.',
  },
  {
    question: '¿Dónde está la clínica y cómo llego?',
    answer:
      'Estamos en Calle Poeta Aurora Albornoz, 7, en Teatinos (29010, Málaga). Puedes abrir la ubicación en Google Maps desde los enlaces de contacto de esta página.',
  },
  {
    question: '¿Qué horario de atención tenéis?',
    answer:
      'Atendemos de lunes a jueves de 10:00 a 21:00 h y los viernes de 10:00 a 14:00 h.',
  },
  {
    question: '¿Ofrecéis teleconsulta?',
    answer:
      'Sí. Puedes agendar una teleconsulta desde esta página para contarnos qué necesitas y orientarte antes de venir a la clínica.',
  },
  {
    question: '¿Atendéis urgencias dentales?',
    answer: '[Respuesta pendiente]',
  },
];
---

<Faqs id="faqs-contacto" title="Preguntas frecuentes sobre tu cita en Dentinos." faqs={faqs}>
  <div class="faq-aside" slot="aside">
    <h3 class="faq-aside__title">¿Prefieres que te atendamos ya?</h3>
    <p class="faq-aside__text">
      Escríbenos por WhatsApp o llámanos y resolvemos tu duda al momento. También
      puedes agendar una teleconsulta sin compromiso.
    </p>
    <CtaButtons size="lg" />
  </div>
</Faqs>

<style>
  .faq-aside {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.125rem);
  }

  .faq-aside__title {
    font-weight: 500;
    font-size: var(--text-h3);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  .faq-aside__text {
    max-width: 23rem;
    font-size: var(--text-lead);
    line-height: 1.17;
    letter-spacing: -0.04em;
    color: var(--color-blue-dark-hover);
  }
</style>
