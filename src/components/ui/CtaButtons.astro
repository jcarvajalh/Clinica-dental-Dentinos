---
import { appointmentHref, teleconsultaHref } from '@/data/site';

interface Props {
  /** 'lg' = hero (16px, elevado); 'sm' = compacto dentro de texto (12px). */
  size?: 'lg' | 'sm';
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;
const btnSize = size === 'sm' ? 'btn-xs' : 'btn-sm';
---

<div class:list={['cta-pair', `cta-pair--${size}`, className]}>
  <a href={appointmentHref} class:list={['btn', 'btn-primary', btnSize]}>
    Agendar Cita
  </a>
  <a href={teleconsultaHref} class:list={['btn', 'btn-secondary', btnSize]}>
    Teleconsulta
  </a>
</div>

<style>
  .cta-pair {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-pair--sm {
    gap: 0.5rem;
  }

  /* El botón primario del hero va elevado; el compacto no (según Figma). */
  .cta-pair--lg .btn-primary {
    box-shadow: var(--shadow-btn);
  }

  /* Animación sutil al pasar el cursor: el botón se eleva ligeramente.
     Solo transform (§9); se suma a la transición de color heredada de .btn. */
  .cta-pair .btn {
    transition: background-color var(--duration-base) var(--ease-out-soft),
      color var(--duration-base) var(--ease-out-soft),
      transform var(--duration-base) var(--ease-out-soft);
  }

  .cta-pair .btn:hover {
    transform: translateY(-2px);
  }

  .cta-pair .btn:active {
    transform: translateY(0);
  }

  /* Sin movimiento si el usuario lo pide (§9, §11). */
  @media (prefers-reduced-motion: reduce) {
    .cta-pair .btn:hover,
    .cta-pair .btn:active {
      transform: none;
    }
  }
</style>
