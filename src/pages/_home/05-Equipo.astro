---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';
import CtaButtons from '@/components/ui/CtaButtons.astro';

/*
 * Contenido exclusivo de esta sección (§7): el equipo médico solo aparece
 * aquí por ahora. Si se reutiliza en /nosotros, se extrae a src/data/.
 * Orden y textos tomados del Figma (fila de 3 + fila de 2 centrada).
 */
interface Member {
  slug: string;
  name: string;
  specialty: string;
  license: string;
  description: string;
}

const members: Member[] = [
  {
    slug: 'team-fernandez-cavada',
    name: 'Dra. Fernández-Cavada',
    specialty: 'Ortodoncista',
    license: 'DN20485',
    description: 'Especialista en ortodoncia y ortopedia dentomaxilar.',
  },
  {
    slug: 'team-ramos',
    name: 'Dr. Ramos',
    specialty: 'Implantología',
    license: 'DN18563',
    description: 'Cirujano local y especialista en implantología.',
  },
  {
    slug: 'team-ternero',
    name: 'Dr. Ternero',
    specialty: 'Prostodoncista',
    license: 'DN22109',
    description: 'Odontólogo general y especialista en prostodoncia.',
  },
  {
    slug: 'team-molina',
    name: 'Dr. Molina',
    specialty: 'Endodoncista',
    license: 'DN22909',
    description: 'Especialista en endodoncia y odontología restauradora.',
  },
  {
    slug: 'team-salamanca',
    name: 'Dra. Salamanca',
    specialty: 'Odontóloga',
    license: 'DN56845',
    description: 'Odontóloga general y especialista en cirugía.',
  },
];
---

<section class="team" aria-labelledby="team-title">
  <div class="team__inner">
    <header class="team__head">
      <p class="eyebrow">Equipo médico</p>
      <h2 id="team-title" class="section-title">Conoce a nuestro equipo médico</h2>
    </header>

    <ul class="team__grid" role="list">
      {
        members.map((m) => (
          <li class="member">
            <div class="member__photo">
              <Image
                src={img(m.slug)}
                alt={`${m.name}, ${m.specialty.toLowerCase()} de la Clínica Dental Dentinos`}
                widths={[280, 300, 400, 600]}
                sizes="(min-width: 1024px) 23vw, (min-width: 640px) 44vw, 90vw"
                class="member__img"
              />
              <div class="member__badge">
                <h3 class="member__name">{m.name}</h3>
                <p class="member__role">{m.specialty} - Licencia: {m.license}</p>
              </div>
            </div>
            <p class="member__desc">{m.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="team__cta">
      <CtaButtons size="lg" />
    </div>
  </div>
</section>

<style>
  .team {
    background-color: var(--color-white);
    padding-block: var(--section-py);
  }

  .team__inner {
    padding-inline: var(--inset-section);
  }

  .team__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-head);
    margin-bottom: clamp(2.25rem, 1.25rem + 3vw, 4rem);
  }

  /* CTA centrado al pie de la sección. */
  .team__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 1.8rem + 3vw, 3.75rem);
  }

  /* --- Rejilla: 5 tarjetas en una sola fila en escritorio -------------- */
  .team__grid {
    --col-gap: clamp(1rem, 0.6rem + 1.4vw, 1.875rem); /* → 30px @1440 */
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* móvil: 2 columnas */
    justify-items: center;
    gap: clamp(2.25rem, 1.8rem + 2vw, 3rem) var(--col-gap);
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
  }

  .member {
    position: relative; /* permite el z-index al ampliarse en hover */
    container-type: inline-size; /* la tipografía escala con el ancho real de la card */
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 21.875rem; /* 350px: tope de la card (foto 350×350) */
    margin-inline: auto;
    transition: transform var(--duration-slow) var(--ease-out-soft);
  }

  /* --- Foto cuadrada con la píldora del nombre superpuesta ------------- */
  .member__photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-media); /* 24 → 50px */
    overflow: hidden;
  }

  .member__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member__badge {
    position: absolute;
    inset-inline: 6.06%; /* 18/297 */
    bottom: 6.06%;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    /* Padding y radio proporcionales al ancho de la card (cqw). */
    padding: clamp(0.25rem, 3cqw, 0.5rem) clamp(0.4375rem, 5cqw, 0.9375rem);
    background-color: var(--color-white);
    border-radius: clamp(0.625rem, 6cqw, 1.5rem);
  }

  /* Tipografía proporcional al tamaño de la imagen (cqw = % del ancho de card). */
  .member__name {
    font-size: clamp(0.625rem, 7.5cqw, 1.125rem); /* ~10 → 18px según la card */
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  .member__role {
    font-style: italic;
    font-weight: 300;
    font-size: clamp(0.5rem, 5.5cqw, 0.9375rem); /* ~8 → 15px según la card */
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  .member__desc {
    margin-top: clamp(0.375rem, 3cqw, 0.75rem);
    font-size: clamp(0.6875rem, 7cqw, 1.0625rem); /* ~11 → 17px según la card */
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  /* --- Tablet: 3 columnas --------------------------------------------- */
  @media (min-width: 640px) {
    .team__grid {
      grid-template-columns: repeat(3, 1fr);
      max-width: 48rem;
    }
  }

  /* --- Escritorio: las 5 tarjetas en una sola fila -------------------- */
  @media (min-width: 1024px) {
    .team__grid {
      grid-template-columns: repeat(5, 1fr);
      /* sigue creciendo en pantallas grandes (§6); nunca desborda el inset. */
      max-width: clamp(54rem, 72vw, 82rem);
      overflow: visible;
    }

    .member {
      max-width: none; /* lo dimensiona la columna del grid (~148–205px) */
      margin-inline: 0;
    }
  }

  /* Hover: la tarjeta se amplía (×2) por encima de las demás y vuelve a su
     tamaño al salir. Solo con puntero fino (no en táctil). Las tarjetas de
     los extremos crecen hacia dentro para no provocar scroll horizontal. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .member:hover {
      transform: scale(1.5);
      z-index: 5;
    }

    .member:first-child:hover {
      transform-origin: left center;
    }

    .member:last-child:hover {
      transform-origin: right center;
    }
  }
</style>
