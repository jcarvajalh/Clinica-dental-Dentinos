---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';
import { site } from '@/data/site';
import CtaButtons from '@/components/ui/CtaButtons.astro';

/*
 * Sección "Visítanos / Ubicación" (§7: contenido exclusivo de esta sección).
 * Composición: mapa central con tarjeta-pin de la clínica + 4 fotos flotantes
 * decorativas (rotadas) a los lados + CTA. El título corrige el «en en» del Figma.
 * Las fotos flotantes son decorativas: se ocultan en móvil para evitar ruido.
 */
const mapsHref = site.mapsUrl || '#';
---

<section class="location" aria-labelledby="location-title">
  <header class="location__head">
    <p class="eyebrow">Visítanos</p>
    <h2 id="location-title" class="section-title">
      Estamos ubicados en Teatinos, Málaga
    </h2>
  </header>

  <div class="location__stage">
    {/* Par izquierdo: dos fotos que se solapan por la punta (decorativas) */}
    <div class="location__cluster location__cluster--left" aria-hidden="true">
      <Image
        src={img('location-equipo')}
        alt=""
        widths={[224, 340, 460]}
        sizes="15vw"
        class="location__float"
        style="--rotate:-5.15deg"
      />
      <Image
        src={img('location-sala')}
        alt=""
        widths={[224, 340, 460]}
        sizes="15vw"
        class="location__float location__float--over"
        style="--rotate:9.07deg"
      />
    </div>

    <div class="location__map">
      <Image
        src={img('location-mapa')}
        alt="Mapa de la ubicación de la Clínica Dental Dentinos en Teatinos, Málaga"
        widths={[560, 876, 1200, 1600]}
        sizes="(min-width: 56.25rem) 62vw, 92vw"
        class="location__map-img"
      />

      <figure class="place">
        <span class="place__marker" aria-hidden="true">
          <span class="place__pin">
            <Image src={img('location-pin')} alt="" width={17} height={16} />
          </span>
        </span>

        <Image
          src={img('location-fachada')}
          alt="Fachada de la Clínica Dental Dentinos"
          widths={[108, 216, 320]}
          sizes="10rem"
          class="place__photo"
        />

        <figcaption class="place__info">
          <p class="place__name">Clínica Dental Dentinos</p>
          <p class="place__hours">L - V 10:00 am - 9:00 pm</p>
          <p class="place__amenities">Wifi | Café | Comfort</p>
          <a
            href={mapsHref}
            class="place__maps"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver en maps
          </a>
        </figcaption>
      </figure>
    </div>

    {/* Par derecho: dos fotos que se solapan por la punta (decorativas) */}
    <div class="location__cluster location__cluster--right" aria-hidden="true">
      <Image
        src={img('location-recepcion')}
        alt=""
        widths={[224, 340, 460]}
        sizes="15vw"
        class="location__float"
        style="--rotate:15.87deg"
      />
      <Image
        src={img('location-consulta')}
        alt=""
        widths={[224, 340, 460]}
        sizes="15vw"
        class="location__float location__float--over"
        style="--rotate:-7.66deg"
      />
    </div>
  </div>

  <div class="location__cta">
    <CtaButtons size="lg" />
  </div>
</section>

<style>
  .location {
    background-color: var(--color-white);
    padding-block: var(--section-py);
    overflow: hidden; /* las fotos flotantes rotadas no provocan scroll */
  }

  /* --- Cabecera -------------------------------------------------------- */
  .location__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-head);
    padding-inline: var(--inset-section);
    margin-bottom: clamp(1.5rem, 0.9rem + 2.4vw, 2.5rem);
  }

  /* --- Escenario: mapa centrado + fotos flotantes ---------------------- */
  .location__stage {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    padding-inline: var(--gutter);
  }

  .location__map {
    position: relative;
    width: 100%;
    /* 876px @1440 (≈62vw); sigue creciendo en pantallas grandes (§6). */
    max-width: clamp(20rem, 62vw, 73rem);
  }

  .location__map-img {
    width: 100%;
    height: auto;
    aspect-ratio: 876 / 407;
    object-fit: cover;
    border-radius: var(--radius-media); /* 50px @1440 */
  }

  /* --- Fotos flotantes decorativas (solo escritorio) ------------------- */
  /* Cada lado es un clúster de 2 fotos que se solapan por la punta. */
  .location__cluster {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  .location__cluster--left {
    left: 1%;
    align-items: flex-start;
  }

  .location__cluster--right {
    right: 1%;
    align-items: flex-end;
  }

  .location__float {
    /* Proporción natural (las PNG ya traen su redondeo en las 4 esquinas);
       sin object-fit/aspect-ratio para no recortarlas ni deformarlas. */
    width: clamp(9rem, 15vw, 14rem); /* más grandes que antes (180 → 224px) */
    height: auto;
    transform: rotate(var(--rotate));
  }

  /* La segunda foto sube para solaparse con la primera por la esquina y
     queda por encima; cada lado la desplaza ligeramente hacia su borde. */
  .location__float--over {
    margin-top: -20%;
    position: relative;
    z-index: 1;
  }

  .location__cluster--left .location__float--over {
    margin-left: -10%;
  }

  .location__cluster--right .location__float--over {
    margin-right: -10%;
  }

  /* --- Tarjeta-pin sobre el mapa --------------------------------------- */
  .place {
    position: absolute;
    left: 36%;
    top: 16%;
    z-index: 3;
    width: clamp(8.5rem, 7rem + 4vw, 10rem); /* legible aunque el mapa escale */
    display: flex;
    flex-direction: column;
    gap: clamp(0.25rem, 0.2rem + 0.2vw, 0.4375rem);
    padding: clamp(0.4375rem, 0.35rem + 0.3vw, 0.625rem);
    background-color: var(--color-white);
    border-radius: 1.25rem; /* 20px */
    box-shadow: var(--shadow-glass);
  }

  /* Pin: círculo azul con icono + cola triangular hacia la tarjeta. */
  .place__marker {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .place__pin {
    display: grid;
    place-items: center;
    width: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    height: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    border-radius: 50%;
    background-color: var(--color-blue-darker);
  }

  .place__pin :global(img) {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }

  /* Cola triangular blanca que apunta a la tarjeta. */
  .place__marker::after {
    content: '';
    width: 0;
    height: 0;
    border-inline: 0.4375rem solid transparent;
    border-top: 0.375rem solid var(--color-white);
    margin-top: -0.0625rem;
  }

  .place__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 108 / 82;
    object-fit: cover;
    border-radius: 0.875rem; /* 14px */
  }

  .place__info {
    display: flex;
    flex-direction: column;
    gap: clamp(0.1875rem, 0.15rem + 0.15vw, 0.3125rem);
  }

  .place__name {
    font-weight: 500;
    font-size: clamp(0.625rem, 0.58rem + 0.2vw, 0.75rem); /* 10 → 12px */
    line-height: 1.2;
    color: var(--color-black);
  }

  .place__hours,
  .place__amenities {
    font-size: clamp(0.625rem, 0.6rem + 0.12vw, 0.6875rem); /* 10 → 11px */
    line-height: 1.2;
    color: var(--color-black);
  }

  .place__maps {
    align-self: flex-start;
    margin-top: 0.125rem;
    padding: 0.1875rem 0.75rem;
    font-size: clamp(0.5625rem, 0.53rem + 0.15vw, 0.6875rem); /* 9 → 11px */
    line-height: 1.2;
    color: var(--color-blue-light);
    background-color: var(--color-blue-dark-active);
    border-radius: var(--radius-btn-sm); /* 15px */
    transition: background-color var(--duration-base) var(--ease-out-soft);
  }

  .place__maps:hover {
    background-color: var(--color-blue-darker);
  }

  /* --- CTA inferior (centrado) ---------------------------------------- */
  .location__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 1rem + 3vw, 2.75rem);
  }

  /* --- Móvil: sin fotos flotantes; tarjeta algo mayor ------------------ */
  @media (max-width: 56.1875rem) {
    .location__cluster {
      display: none;
    }

    .place {
      width: clamp(9rem, 40vw, 11rem);
    }
  }
</style>
