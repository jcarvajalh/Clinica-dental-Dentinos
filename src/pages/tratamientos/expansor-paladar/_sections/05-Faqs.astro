---
import Faqs from '@/components/sections/Faqs.astro';
import CtaButtons from '@/components/ui/CtaButtons.astro';

/* Instancia de FAQ para la página del Expansor de paladar. Maquetación en la
 * sección reutilizable `components/sections/Faqs.astro`. */
const faqs = [
  {
    question: '¿A qué edad se recomienda el expansor de paladar?',
    answer:
      'El Invisalign Palatal Expander está indicado para niños de entre 6 y 11 años, durante la fase de dentición mixta, cuando el maxilar aún está en crecimiento.',
  },
  {
    question: '¿Es cómodo y estético?',
    answer: '[Respuesta pendiente]',
  },
  {
    question: '¿Se puede quitar para comer y cepillarse?',
    answer: '[Respuesta pendiente]',
  },
  {
    question: '¿Cuánto dura el tratamiento?',
    answer: '[Respuesta pendiente]',
  },
  {
    question: '¿Necesita una primera valoración?',
    answer: '[Respuesta pendiente]',
  },
];
---

<Faqs
  id="faqs-expansor"
  title="Resuelve tus dudas sobre el expansor de paladar."
  faqs={faqs}
>
  <div class="faq-aside" slot="aside">
    <h3 class="faq-aside__title">¿Tienes otra pregunta?</h3>
    <p class="faq-aside__text">
      Resolvemos tus dudas por teléfono, WhatsApp o en la clínica. Pide tu
      primera visita gratuita y valoramos el caso de tu hijo en persona.
    </p>
    <CtaButtons size="lg" />
  </div>
</Faqs>

<style>
  .faq-aside {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.125rem);
  }

  .faq-aside__title {
    font-weight: 500;
    font-size: var(--text-h3);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  .faq-aside__text {
    max-width: 23rem;
    font-size: var(--text-lead);
    line-height: 1.17;
    letter-spacing: -0.04em;
    color: var(--color-blue-dark-hover);
  }
</style>
