---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';
import CtaButtons from '@/components/ui/CtaButtons.astro';

/* «¿Cuánto duran las carillas dentales?» — texto (izq.) + foto de estilo de vida
 * (dcha.). Cierra con «Más información». */
---

<section class="last" aria-labelledby="last-title">
  <div class="last__grid">
    <div class="last__text">
      <h2 id="last-title" class="last__title">
        ¿Cuánto duran las carillas dentales?
      </h2>

      <p class="last__p">
        Las carillas dentales son un tratamiento muy duradero siempre que se
        haga un buen uso de ellas. Para conseguirlo es clave mantener una buena
        higiene bucodental y acudir al dentista con regularidad.
      </p>
      <p class="last__p">
        Evita sobrecargarlas o darles un uso poco seguro, ya que podrían
        romperse, despegarse o fracturarse. Si una carilla se desprende, puede
        volver a colocarse sin problema; cuando se produce una rotura, se
        sustituye por una nueva.
      </p>

      <div class="last__cta">
        <CtaButtons size="lg" />
      </div>
    </div>

    <figure class="last__media">
      <Image
        src={img('carillas-duracion')}
        alt="Pareja sonriente al aire libre mostrando el resultado natural y duradero de sus carillas dentales"
        widths={[440, 620, 820, 1080]}
        sizes="(min-width: 60rem) 42vw, 92vw"
        class="last__img"
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .last {
    background-color: var(--color-white);
    padding-block: var(--section-py);
    padding-inline: var(--inset-section);
  }

  .last__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 1.1rem + 2.6vw, 3.75rem);
    align-items: center;
  }

  .last__title {
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  .last__p {
    margin-top: clamp(1rem, 0.8rem + 0.9vw, 1.375rem);
    font-size: var(--text-lead);
    line-height: 1.45;
    letter-spacing: -0.02em;
    text-wrap: pretty;
    color: var(--color-blue-dark-hover);
  }

  .last__cta {
    display: flex;
    margin-top: clamp(1.5rem, 1.1rem + 1.6vw, 2.1875rem);
  }

  .last__media {
    margin: 0;
    order: -1;
  }

  .last__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  /* --- Escritorio (≥60rem): texto | foto ------------------------------- */
  @media (min-width: 60rem) {
    .last__grid {
      grid-template-columns: minmax(0, 560fr) minmax(0, 500fr);
    }

    .last__media {
      order: 0; /* foto a la derecha */
    }

    .last__img {
      aspect-ratio: 500 / 500;
    }
  }
</style>
