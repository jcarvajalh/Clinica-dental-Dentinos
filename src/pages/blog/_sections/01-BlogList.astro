---
import ArticleCard from '@/components/ui/ArticleCard.astro';
import { blogPosts, blogCategories } from '@/data/blog';

/*
 * Listado del blog: intro + buscador + filtros por categoría + rejilla de
 * artículos + paginación. El buscador, los filtros y la paginación son
 * progresivos: las tarjetas se renderizan en el HTML (SEO) y un pequeño script
 * vanilla las filtra/pagina en cliente. Sin JS, se ven todos los artículos.
 *
 * Nota: el <h1> no aparece en el Figma; se añade por SEO y accesibilidad (§11,
 * un solo <h1> por página).
 */
const perPage = 9;
---

<section class="blog" aria-labelledby="blog-title" data-blog data-per-page={perPage}>
  <header class="blog__intro">
    <h1 id="blog-title" class="blog__title">
      Blog y consejos de salud dental en Málaga
    </h1>
    <p class="blog__lead">
      En el blog de Dentinos, nuestra clínica dental en Málaga, encontrarás
      información útil para cuidar tu salud bucodental y conocer las últimas
      novedades en odontología. Compartimos consejos de prevención,
      recomendaciones para mantener una buena higiene dental y contenidos sobre
      los tratamientos más avanzados.
    </p>
  </header>

  <div class="blog__toolbar">
    <form class="blog__search" role="search" data-search-form>
      <svg class="blog__search-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
        <line x1="10.8" y1="10.8" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        class="blog__search-input"
        placeholder="Buscar artículos . . ."
        aria-label="Buscar artículos"
        data-search
      />
    </form>

    <div class="blog__filters" role="group" aria-label="Filtrar artículos por categoría">
      <button type="button" class="chip is-active" data-filter="Todos" aria-pressed="true">
        Todos
      </button>
      {
        blogCategories.map((cat) => (
          <button type="button" class="chip" data-filter={cat} aria-pressed="false">
            {cat}
          </button>
        ))
      }
    </div>
  </div>

  <div class="blog__grid" data-grid>
    {blogPosts.map((post) => <ArticleCard post={post} />)}
  </div>

  <p class="blog__empty" data-empty hidden>
    No encontramos artículos que coincidan con tu búsqueda.
  </p>

  <nav class="blog__pagination" aria-label="Paginación de artículos" data-pagination></nav>
</section>

<style>
  .blog {
    background-color: var(--color-white);
    padding-top: calc(var(--header-height) + clamp(1.5rem, 1rem + 2vw, 2.375rem));
    padding-bottom: var(--section-py);
    padding-inline: var(--inset-section);
  }

  /* --- Intro ------------------------------------------------------------ */
  .blog__title {
    max-width: 46rem;
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: var(--color-blue-darker);
  }

  .blog__lead {
    max-width: 40.5rem; /* 648px (Figma) */
    margin-top: clamp(1rem, 0.8rem + 0.9vw, 1.375rem);
    font-size: 1rem; /* 16px (Figma) */
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-wrap: pretty;
    color: var(--color-blue-dark-hover); /* #2A5685 */
  }

  /* --- Barra de herramientas (buscador + filtros) ---------------------- */
  .blog__toolbar {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 0.8rem + 0.9vw, 1.5rem);
    margin-top: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
  }

  .blog__search {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    max-width: 25.625rem; /* 410px (Figma) */
    min-height: 2.75rem; /* área táctil ≥44px (§11) */
    padding: 0.5rem 1.125rem;
    background-color: var(--color-white);
    border: 1px solid rgb(0 0 0 / 0.2);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    border-radius: 1.25rem; /* 20px */
  }

  .blog__search:focus-within {
    outline: 2px solid var(--color-blue-dark);
    outline-offset: 2px;
  }

  .blog__search-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--color-blue-dark-hover);
  }

  .blog__search-input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-blue-dark-hover);
    background: transparent;
    border: 0;
    outline: none;
  }

  .blog__search-input::placeholder {
    color: var(--color-blue-dark-hover);
    opacity: 1;
  }

  .blog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* área táctil ≥44px (§11) */
    padding: 0.375rem 1.25rem;
    font-size: 1rem; /* 16px */
    line-height: 1.2;
    color: var(--color-blue-dark-hover);
    background-color: var(--color-blue-light-hover);
    border: 0.5px solid rgb(42 86 133 / 0.5);
    border-radius: 1.25rem;
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-out-soft),
      color var(--duration-base) var(--ease-out-soft);
  }

  .chip:hover {
    background-color: var(--color-blue-light-active);
  }

  .chip.is-active {
    color: var(--color-white);
    background-color: var(--color-blue-darker);
    border-color: var(--color-blue-darker);
  }

  /* --- Rejilla de artículos -------------------------------------------- */
  .blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1.4rem + 2.4vw, 3.125rem) clamp(1rem, 0.7rem + 1.2vw, 1.5rem);
    /* Rejilla centrada y más estrecha → tarjetas ~35% más pequeñas que a todo
       el ancho (coincide con el ancho centrado del Figma). */
    max-width: 50rem; /* ~800px */
    margin-top: clamp(2rem, 1.4rem + 2.4vw, 3.125rem);
    margin-inline: auto;
  }

  .blog__empty {
    margin-top: 2rem;
    font-size: var(--text-lead);
    color: var(--color-blue-dark-hover);
  }

  /* --- Paginación ------------------------------------------------------ */
  .blog__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
  }

  /* Botones de página (inyectados por JS). */
  .blog__pagination :global(.page) {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 0.875rem; /* 14px */
    color: var(--color-blue-darker);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-out-soft);
  }

  .blog__pagination :global(.page:hover) {
    background-color: var(--color-blue-light-hover);
  }

  .blog__pagination :global(.page.is-active) {
    background-color: var(--color-blue-light-active); /* #ACDFF0 */
  }

  /* --- Tablet (≥40rem): 2 columnas ------------------------------------- */
  @media (min-width: 40rem) {
    .blog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* --- Escritorio (≥60rem): 3 columnas --------------------------------- */
  @media (min-width: 60rem) {
    .blog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  // Buscador + filtros + paginación en cliente (mejora progresiva). Las tarjetas
  // ya están en el HTML; aquí solo se muestran/ocultan y se paginan.
  const mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-blog]').forEach((section) => {
    const grid = section.querySelector<HTMLElement>('[data-grid]');
    const searchInput = section.querySelector<HTMLInputElement>('[data-search]');
    const searchForm = section.querySelector<HTMLFormElement>('[data-search-form]');
    const chips = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const empty = section.querySelector<HTMLElement>('[data-empty]');
    const pagination = section.querySelector<HTMLElement>('[data-pagination]');
    if (!grid || !pagination) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    const perPage = Number(section.dataset.perPage) || 9;

    let category = 'Todos';
    let query = '';
    let page = 1;

    const getFiltered = () =>
      cards.filter((card) => {
        const okCat = category === 'Todos' || card.dataset.category === category;
        const okQuery = !query || (card.dataset.title ?? '').includes(query);
        return okCat && okQuery;
      });

    const renderPagination = (pages: number) => {
      pagination.innerHTML = '';
      if (pages <= 1) return;
      for (let i = 1; i <= pages; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'page';
        btn.textContent = String(i);
        btn.setAttribute('aria-label', `Ir a la página ${i}`);
        if (i === page) {
          btn.classList.add('is-active');
          btn.setAttribute('aria-current', 'page');
        }
        btn.addEventListener('click', () => {
          page = i;
          render();
          section.scrollIntoView({
            behavior: mqReduce.matches ? 'auto' : 'smooth',
            block: 'start',
          });
        });
        pagination.appendChild(btn);
      }
    };

    const render = () => {
      const filtered = getFiltered();
      const pages = Math.max(1, Math.ceil(filtered.length / perPage));
      if (page > pages) page = pages;

      cards.forEach((card) => {
        card.hidden = true;
      });
      const start = (page - 1) * perPage;
      filtered.slice(start, start + perPage).forEach((card) => {
        card.hidden = false;
      });

      if (empty) empty.hidden = filtered.length > 0;
      renderPagination(pages);
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        category = chip.dataset.filter ?? 'Todos';
        page = 1;
        chips.forEach((c) => {
          const active = c === chip;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        render();
      });
    });

    searchForm?.addEventListener('submit', (e) => e.preventDefault());
    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      page = 1;
      render();
    });

    render();
  });
</script>
